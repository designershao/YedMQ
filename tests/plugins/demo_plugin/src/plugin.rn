fn on_auth_logic(connect_info) {
    let succeed = samoye::hook::AuthenticateSucceed {
        tenant_id: "public",
        user_id: "public"
    };
    let result = samoye::hook::AuthenticateResult::Success;
    return result;
}

pub fn on_activate(context) {
    context.hook_register(samoye::hook::Hooks::OnConnectAuth, on_auth_logic);
}

pub fn on_deactivate() {

}